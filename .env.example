# ============================================================
# MediSense AI — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=medisense_db
POSTGRES_USER=medisense_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- JWT ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
APP_ENV=development        # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["https://localhost", "http://localhost:3000"]

# --- RGPD ---
# Separate encryption key for identity table (AES-256 via pgcrypto)
# Generate with: openssl rand -hex 32
PGCRYPTO_KEY=CHANGE_ME_separate_key_for_identity_encryption

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Ollama ---
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=mistral:7b-instruct
