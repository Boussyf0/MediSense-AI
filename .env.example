# ============================================================
# MediSense AI — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=medisense_db
POSTGRES_USER=medisense_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- JWT ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
APP_ENV=development        # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["https://localhost", "http://localhost:3000"]

# --- RGPD ---
# Separate encryption key for identity table (AES-256 via pgcrypto)
# Generate with: openssl rand -hex 32
PGCRYPTO_KEY=CHANGE_ME_separate_key_for_identity_encryption

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- LLM Provider ---
# "ollama" = local inference  |  "groq" = cloud inference (~300 tok/s, free tier)
LLM_PROVIDER=ollama

# --- Ollama (LLM_PROVIDER=ollama) ---
# Docker service (CPU-only, ~0.4 tok/s) :
#   OLLAMA_HOST=ollama
# Native Mac M1 avec Metal GPU (~20-40 tok/s) :
#   1. brew install ollama && ollama serve  (sur le Mac, hors Docker)
#   2. OLLAMA_HOST=host.docker.internal
#   3. Commenter le service ollama dans docker-compose.yml
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:3b

# --- Groq (LLM_PROVIDER=groq) ---
# Créer une clé gratuite sur https://console.groq.com
# Modèles disponibles : llama-3.1-8b-instant | llama-3.3-70b-versatile | mixtral-8x7b-32768
GROQ_API_KEY=gsk_CHANGE_ME
GROQ_MODEL=llama-3.1-8b-instant

# --- SMS reminders (Sprint 5) ---
# Leave SMS_WEBHOOK_URL empty to run in mock mode (dev/staging demo).
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_PROVIDER_TIMEOUT_SECONDS=3.0
SMS_REMINDER_THRESHOLD=0.30
SMS_REMINDER_MAX_COUNT=2

# --- Salesforce CRM (Sprint 6) ---
# Leave SALESFORCE_WEBHOOK_URL empty to skip CRM sync (dev/demo mode).
SALESFORCE_WEBHOOK_URL=
SALESFORCE_TOKEN=
SALESFORCE_TIMEOUT_SECONDS=3.0
SALESFORCE_MAX_RETRIES=3
SALESFORCE_RETRY_DELAY_SECONDS=2.0

# --- MLflow Model Registry (Sprint 6) ---
MLFLOW_MODEL_NAME=noshow-risk-model
MLFLOW_PROMOTION_F1_THRESHOLD=0.80
MLFLOW_PROMOTION_AUC_THRESHOLD=0.87
