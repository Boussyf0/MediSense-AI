[run]
source = app
# Only omit pure infrastructure (session middleware) and external adapters
# that require live services not available in CI.
omit =
    app/db/session.py
    app/main.py
    app/rag/pipeline.py
    app/rag/llm.py
    app/rag/vectorstore.py
    app/rag/embedder.py
    app/rag/reranker.py
    app/rag/normalizer.py
    app/mcp/*
    app/services/kafka_consumer.py
    app/services/lstm_anomaly_service.py

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    \.\.\.
    @(abc\.)?abstractmethod
    if TYPE_CHECKING:
    class .*\bProtocol\b
    @overload
