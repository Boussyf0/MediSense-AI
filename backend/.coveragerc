[run]
source = app
# Force the sys.monitoring core (PEP 669). The default C tracer drops line
# events for `await` statements and the lines after them, undercounting every
# async endpoint — it reported the suite at ~80% when it is actually ~94%.
# Do not remove: without this the coverage gate is measuring fiction.
core = sysmon
# Only omit pure infrastructure (session middleware) and external adapters
# that require live services not available in CI.
omit =
    app/db/session.py
    app/main.py
    app/rag/pipeline.py
    app/rag/llm.py
    app/rag/vectorstore.py
    app/rag/embedder.py
    app/rag/reranker.py
    app/rag/normalizer.py
    app/mcp/*
    app/services/kafka_consumer.py
    app/services/lstm_anomaly_service.py

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    \.\.\.
    @(abc\.)?abstractmethod
    if TYPE_CHECKING:
    class .*\bProtocol\b
    @overload
