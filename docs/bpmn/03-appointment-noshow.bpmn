<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Appointment" targetNamespace="http://medisense.ai/bpmn">
  <bpmn:collaboration id="Collab_Appointment">
    <bpmn:participant id="Participant_Booking" name="Patient booking" processRef="Process_Booking"/>
    <bpmn:participant id="Participant_Secretary" name="Secretary reminders" processRef="Process_Secretary"/>
    <bpmn:participant id="Participant_CRM" name="CRM retry" processRef="Process_CRM"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Booking" name="Appointment booking" isExecutable="false">
    <bpmn:startEvent id="Start_Book" name="Patient books">
      <bpmn:outgoing>F_B1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Post" name="POST /appointments">
      <bpmn:incoming>F_B1</bpmn:incoming>
      <bpmn:outgoing>F_B2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Future" name="Time in future?">
      <bpmn:incoming>F_B2</bpmn:incoming>
      <bpmn:outgoing>F_FutNo</bpmn:outgoing>
      <bpmn:outgoing>F_FutYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_422" name="422 Unprocessable">
      <bpmn:incoming>F_FutNo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_Doctor" name="Doctor active?">
      <bpmn:incoming>F_FutYes</bpmn:incoming>
      <bpmn:outgoing>F_DocNo</bpmn:outgoing>
      <bpmn:outgoing>F_DocYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_404" name="404 Not Found">
      <bpmn:incoming>F_DocNo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_Conflict" name="Slot conflict?">
      <bpmn:incoming>F_DocYes</bpmn:incoming>
      <bpmn:outgoing>F_ConYes</bpmn:outgoing>
      <bpmn:outgoing>F_ConNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_409" name="409 Conflict">
      <bpmn:incoming>F_ConYes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Predict" name="noshow_predictor.predict (XGBoost)">
      <bpmn:incoming>F_ConNo</bpmn:incoming>
      <bpmn:outgoing>F_B3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Task_RiskColor" name="Assign risk_color green/orange/red">
      <bpmn:incoming>F_B3</bpmn:incoming>
      <bpmn:outgoing>F_B4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_Flush" name="DB flush + audit WRITE">
      <bpmn:incoming>F_B4</bpmn:incoming>
      <bpmn:outgoing>F_B5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_CRMSend" name="Fire-and-forget salesforce_client.send_crm_event">
      <bpmn:incoming>F_B5</bpmn:incoming>
      <bpmn:outgoing>F_B6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_201" name="201 Created">
      <bpmn:incoming>F_B6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F_B1" sourceRef="Start_Book" targetRef="Task_Post"/>
    <bpmn:sequenceFlow id="F_B2" sourceRef="Task_Post" targetRef="GW_Future"/>
    <bpmn:sequenceFlow id="F_FutNo" name="no" sourceRef="GW_Future" targetRef="End_422"/>
    <bpmn:sequenceFlow id="F_FutYes" name="yes" sourceRef="GW_Future" targetRef="GW_Doctor"/>
    <bpmn:sequenceFlow id="F_DocNo" name="no" sourceRef="GW_Doctor" targetRef="End_404"/>
    <bpmn:sequenceFlow id="F_DocYes" name="yes" sourceRef="GW_Doctor" targetRef="GW_Conflict"/>
    <bpmn:sequenceFlow id="F_ConYes" name="yes" sourceRef="GW_Conflict" targetRef="End_409"/>
    <bpmn:sequenceFlow id="F_ConNo" name="no" sourceRef="GW_Conflict" targetRef="Task_Predict"/>
    <bpmn:sequenceFlow id="F_B3" sourceRef="Task_Predict" targetRef="Task_RiskColor"/>
    <bpmn:sequenceFlow id="F_B4" sourceRef="Task_RiskColor" targetRef="Task_Flush"/>
    <bpmn:sequenceFlow id="F_B5" sourceRef="Task_Flush" targetRef="Task_CRMSend"/>
    <bpmn:sequenceFlow id="F_B6" sourceRef="Task_CRMSend" targetRef="End_201"/>
  </bpmn:process>

  <bpmn:process id="Process_Secretary" name="Secretary no-show reminders" isExecutable="false">
    <bpmn:startEvent id="Start_Sec" name="Secretary opens agenda">
      <bpmn:outgoing>F_S1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_GetBatch" name="GET /predictions/no-show/batch">
      <bpmn:incoming>F_S1</bpmn:incoming>
      <bpmn:outgoing>F_S2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Red" name="risk_color = red?">
      <bpmn:incoming>F_S2</bpmn:incoming>
      <bpmn:outgoing>F_RedYes</bpmn:outgoing>
      <bpmn:outgoing>F_RedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SMS" name="POST /reminders/dispatch (Twilio SMS)">
      <bpmn:incoming>F_RedYes</bpmn:incoming>
      <bpmn:outgoing>F_S3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Task_Incr" name="Increment sms_reminders_sent">
      <bpmn:incoming>F_S3</bpmn:incoming>
      <bpmn:outgoing>F_S4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Sec" name="Done">
      <bpmn:incoming>F_S4</bpmn:incoming>
      <bpmn:incoming>F_RedNo</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F_S1" sourceRef="Start_Sec" targetRef="Task_GetBatch"/>
    <bpmn:sequenceFlow id="F_S2" sourceRef="Task_GetBatch" targetRef="GW_Red"/>
    <bpmn:sequenceFlow id="F_RedYes" name="yes" sourceRef="GW_Red" targetRef="Task_SMS"/>
    <bpmn:sequenceFlow id="F_RedNo" name="no" sourceRef="GW_Red" targetRef="End_Sec"/>
    <bpmn:sequenceFlow id="F_S3" sourceRef="Task_SMS" targetRef="Task_Incr"/>
    <bpmn:sequenceFlow id="F_S4" sourceRef="Task_Incr" targetRef="End_Sec"/>
  </bpmn:process>

  <bpmn:process id="Process_CRM" name="CRM retry" isExecutable="false">
    <bpmn:startEvent id="Start_CRM" name="CRM task FAILED">
      <bpmn:outgoing>F_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_Retry" name="POST /crm/tasks/{uuid}/retry">
      <bpmn:incoming>F_C1</bpmn:incoming>
      <bpmn:outgoing>F_C2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW_SF" name="Salesforce 2xx?">
      <bpmn:incoming>F_C2</bpmn:incoming>
      <bpmn:outgoing>F_SFYes</bpmn:outgoing>
      <bpmn:outgoing>F_SFNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Synced" name="status = SYNCED">
      <bpmn:incoming>F_SFYes</bpmn:incoming>
      <bpmn:outgoing>F_C3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Breaker" name="Circuit breaker + RETRY">
      <bpmn:incoming>F_SFNo</bpmn:incoming>
      <bpmn:outgoing>F_C4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_CRM" name="End">
      <bpmn:incoming>F_C3</bpmn:incoming>
      <bpmn:incoming>F_C4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F_C1" sourceRef="Start_CRM" targetRef="Task_Retry"/>
    <bpmn:sequenceFlow id="F_C2" sourceRef="Task_Retry" targetRef="GW_SF"/>
    <bpmn:sequenceFlow id="F_SFYes" name="yes" sourceRef="GW_SF" targetRef="Task_Synced"/>
    <bpmn:sequenceFlow id="F_SFNo" name="no" sourceRef="GW_SF" targetRef="Task_Breaker"/>
    <bpmn:sequenceFlow id="F_C3" sourceRef="Task_Synced" targetRef="End_CRM"/>
    <bpmn:sequenceFlow id="F_C4" sourceRef="Task_Breaker" targetRef="End_CRM"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_Appointment">
      <bpmndi:BPMNShape id="Participant_Booking_di" bpmnElement="Participant_Booking" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="2050" height="280"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Secretary_di" bpmnElement="Participant_Secretary" isHorizontal="true">
        <dc:Bounds x="50" y="320" width="1400" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_CRM_di" bpmnElement="Participant_CRM" isHorizontal="true">
        <dc:Bounds x="50" y="540" width="1400" height="200"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Book_di" bpmnElement="Start_Book">
        <dc:Bounds x="100" y="140" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Post_di" bpmnElement="Task_Post">
        <dc:Bounds x="180" y="118" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Future_di" bpmnElement="GW_Future" isMarkerVisible="true">
        <dc:Bounds x="360" y="133" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_422_di" bpmnElement="End_422">
        <dc:Bounds x="367" y="240" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Doctor_di" bpmnElement="GW_Doctor" isMarkerVisible="true">
        <dc:Bounds x="460" y="133" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_404_di" bpmnElement="End_404">
        <dc:Bounds x="467" y="240" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Conflict_di" bpmnElement="GW_Conflict" isMarkerVisible="true">
        <dc:Bounds x="560" y="133" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_409_di" bpmnElement="End_409">
        <dc:Bounds x="567" y="240" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Predict_di" bpmnElement="Task_Predict">
        <dc:Bounds x="660" y="118" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RiskColor_di" bpmnElement="Task_RiskColor">
        <dc:Bounds x="880" y="118" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Flush_di" bpmnElement="Task_Flush">
        <dc:Bounds x="1100" y="118" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CRMSend_di" bpmnElement="Task_CRMSend">
        <dc:Bounds x="1320" y="118" width="260" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_201_di" bpmnElement="End_201">
        <dc:Bounds x="1620" y="140" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Sec_di" bpmnElement="Start_Sec">
        <dc:Bounds x="100" y="410" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GetBatch_di" bpmnElement="Task_GetBatch">
        <dc:Bounds x="180" y="388" width="220" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Red_di" bpmnElement="GW_Red" isMarkerVisible="true">
        <dc:Bounds x="440" y="403" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SMS_di" bpmnElement="Task_SMS">
        <dc:Bounds x="540" y="388" width="240" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Incr_di" bpmnElement="Task_Incr">
        <dc:Bounds x="820" y="388" width="200" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Sec_di" bpmnElement="End_Sec">
        <dc:Bounds x="1080" y="410" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_CRM_di" bpmnElement="Start_CRM">
        <dc:Bounds x="100" y="630" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Retry_di" bpmnElement="Task_Retry">
        <dc:Bounds x="180" y="608" width="220" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_SF_di" bpmnElement="GW_SF" isMarkerVisible="true">
        <dc:Bounds x="440" y="623" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Synced_di" bpmnElement="Task_Synced">
        <dc:Bounds x="540" y="608" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Breaker_di" bpmnElement="Task_Breaker">
        <dc:Bounds x="540" y="700" width="180" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_CRM_di" bpmnElement="End_CRM">
        <dc:Bounds x="780" y="630" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F_B1_di" bpmnElement="F_B1"><di:waypoint x="136" y="158"/><di:waypoint x="180" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B2_di" bpmnElement="F_B2"><di:waypoint x="320" y="158"/><di:waypoint x="360" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_FutNo_di" bpmnElement="F_FutNo"><di:waypoint x="385" y="183"/><di:waypoint x="385" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_FutYes_di" bpmnElement="F_FutYes"><di:waypoint x="410" y="158"/><di:waypoint x="460" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_DocNo_di" bpmnElement="F_DocNo"><di:waypoint x="485" y="183"/><di:waypoint x="485" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_DocYes_di" bpmnElement="F_DocYes"><di:waypoint x="510" y="158"/><di:waypoint x="560" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ConYes_di" bpmnElement="F_ConYes"><di:waypoint x="585" y="183"/><di:waypoint x="585" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ConNo_di" bpmnElement="F_ConNo"><di:waypoint x="610" y="158"/><di:waypoint x="660" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B3_di" bpmnElement="F_B3"><di:waypoint x="840" y="158"/><di:waypoint x="880" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B4_di" bpmnElement="F_B4"><di:waypoint x="1060" y="158"/><di:waypoint x="1100" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B5_di" bpmnElement="F_B5"><di:waypoint x="1280" y="158"/><di:waypoint x="1320" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B6_di" bpmnElement="F_B6"><di:waypoint x="1580" y="158"/><di:waypoint x="1620" y="158"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="F_S1_di" bpmnElement="F_S1"><di:waypoint x="136" y="428"/><di:waypoint x="180" y="428"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_S2_di" bpmnElement="F_S2"><di:waypoint x="400" y="428"/><di:waypoint x="440" y="428"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_RedYes_di" bpmnElement="F_RedYes"><di:waypoint x="490" y="428"/><di:waypoint x="540" y="428"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_RedNo_di" bpmnElement="F_RedNo"><di:waypoint x="465" y="453"/><di:waypoint x="465" y="500"/><di:waypoint x="1098" y="500"/><di:waypoint x="1098" y="446"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_S3_di" bpmnElement="F_S3"><di:waypoint x="780" y="428"/><di:waypoint x="820" y="428"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_S4_di" bpmnElement="F_S4"><di:waypoint x="1020" y="428"/><di:waypoint x="1080" y="428"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="F_C1_di" bpmnElement="F_C1"><di:waypoint x="136" y="648"/><di:waypoint x="180" y="648"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_C2_di" bpmnElement="F_C2"><di:waypoint x="400" y="648"/><di:waypoint x="440" y="648"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_SFYes_di" bpmnElement="F_SFYes"><di:waypoint x="490" y="648"/><di:waypoint x="540" y="648"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_SFNo_di" bpmnElement="F_SFNo"><di:waypoint x="465" y="673"/><di:waypoint x="465" y="730"/><di:waypoint x="540" y="730"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_C3_di" bpmnElement="F_C3"><di:waypoint x="720" y="648"/><di:waypoint x="780" y="648"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_C4_di" bpmnElement="F_C4"><di:waypoint x="720" y="730"/><di:waypoint x="798" y="730"/><di:waypoint x="798" y="666"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
