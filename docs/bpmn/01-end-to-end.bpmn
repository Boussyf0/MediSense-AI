<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_E2E" targetNamespace="http://medisense.ai/bpmn">
  <bpmn:collaboration id="Collab_E2E">
    <bpmn:participant id="Part_Patient" name="Patient" processRef="Proc_Patient"/>
    <bpmn:participant id="Part_System" name="System (RAG + Services + IoT)" processRef="Proc_System"/>
    <bpmn:participant id="Part_Secretary" name="Secretary" processRef="Proc_Secretary"/>
    <bpmn:participant id="Part_Doctor" name="Doctor" processRef="Proc_Doctor"/>
    <bpmn:participant id="Part_Admin" name="Admin" processRef="Proc_Admin"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Patient" name="Patient" isExecutable="false">
    <bpmn:startEvent id="P_Start" name="Open app"><bpmn:outgoing>fp1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P_Login" name="POST /auth/login"><bpmn:incoming>fp1</bpmn:incoming><bpmn:outgoing>fp2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P_Action" name="Choose action"><bpmn:incoming>fp2</bpmn:incoming><bpmn:outgoing>fp_chat</bpmn:outgoing><bpmn:outgoing>fp_book</bpmn:outgoing><bpmn:outgoing>fp_vitals</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P_Chat" name="POST /chat"><bpmn:incoming>fp_chat</bpmn:incoming><bpmn:outgoing>fp3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P_Book" name="POST /appointments"><bpmn:incoming>fp_book</bpmn:incoming><bpmn:outgoing>fp4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P_Vitals" name="GET /iot/vitals"><bpmn:incoming>fp_vitals</bpmn:incoming><bpmn:outgoing>fp5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P_End" name="Done"><bpmn:incoming>fp3</bpmn:incoming><bpmn:incoming>fp4</bpmn:incoming><bpmn:incoming>fp5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="fp1" sourceRef="P_Start" targetRef="P_Login"/>
    <bpmn:sequenceFlow id="fp2" sourceRef="P_Login" targetRef="P_Action"/>
    <bpmn:sequenceFlow id="fp_chat" name="chat" sourceRef="P_Action" targetRef="P_Chat"/>
    <bpmn:sequenceFlow id="fp_book" name="book" sourceRef="P_Action" targetRef="P_Book"/>
    <bpmn:sequenceFlow id="fp_vitals" name="vitals" sourceRef="P_Action" targetRef="P_Vitals"/>
    <bpmn:sequenceFlow id="fp3" sourceRef="P_Chat" targetRef="P_End"/>
    <bpmn:sequenceFlow id="fp4" sourceRef="P_Book" targetRef="P_End"/>
    <bpmn:sequenceFlow id="fp5" sourceRef="P_Vitals" targetRef="P_End"/>
  </bpmn:process>

  <bpmn:process id="Proc_System" name="System" isExecutable="false">
    <bpmn:startEvent id="S_Start" name="Request in"><bpmn:outgoing>fs1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="S_Auth" name="JWT + audit LOGIN"><bpmn:incoming>fs1</bpmn:incoming><bpmn:outgoing>fs2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="S_RAG" name="RAG pipeline (safety + LLM + cache)"><bpmn:incoming>fs2</bpmn:incoming><bpmn:outgoing>fs3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="S_Predict" name="XGBoost no-show + risk_color"><bpmn:incoming>fs3</bpmn:incoming><bpmn:outgoing>fs4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="S_CRM" name="Fire-and-forget CRM task (Salesforce)"><bpmn:incoming>fs4</bpmn:incoming><bpmn:outgoing>fs5</bpmn:outgoing></bpmn:sendTask>
    <bpmn:serviceTask id="S_IoT" name="Kafka consume - persist - LSTM score"><bpmn:incoming>fs5</bpmn:incoming><bpmn:outgoing>fs6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="S_GW" name="Critical?"><bpmn:incoming>fs6</bpmn:incoming><bpmn:outgoing>fs_y</bpmn:outgoing><bpmn:outgoing>fs_n</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="S_Push" name="FCM push + WebSocket"><bpmn:incoming>fs_y</bpmn:incoming><bpmn:outgoing>fs7</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="S_End" name="Done"><bpmn:incoming>fs7</bpmn:incoming><bpmn:incoming>fs_n</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="fs1" sourceRef="S_Start" targetRef="S_Auth"/>
    <bpmn:sequenceFlow id="fs2" sourceRef="S_Auth" targetRef="S_RAG"/>
    <bpmn:sequenceFlow id="fs3" sourceRef="S_RAG" targetRef="S_Predict"/>
    <bpmn:sequenceFlow id="fs4" sourceRef="S_Predict" targetRef="S_CRM"/>
    <bpmn:sequenceFlow id="fs5" sourceRef="S_CRM" targetRef="S_IoT"/>
    <bpmn:sequenceFlow id="fs6" sourceRef="S_IoT" targetRef="S_GW"/>
    <bpmn:sequenceFlow id="fs_y" name="yes" sourceRef="S_GW" targetRef="S_Push"/>
    <bpmn:sequenceFlow id="fs_n" name="no" sourceRef="S_GW" targetRef="S_End"/>
    <bpmn:sequenceFlow id="fs7" sourceRef="S_Push" targetRef="S_End"/>
  </bpmn:process>

  <bpmn:process id="Proc_Secretary" name="Secretary" isExecutable="false">
    <bpmn:startEvent id="Sec_Start" name="Open agenda"><bpmn:outgoing>fsec1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Sec_NoShow" name="GET no-show/batch + risk chips"><bpmn:incoming>fsec1</bpmn:incoming><bpmn:outgoing>fsec2</bpmn:outgoing></bpmn:task>
    <bpmn:sendTask id="Sec_SMS" name="Dispatch SMS reminders"><bpmn:incoming>fsec2</bpmn:incoming><bpmn:outgoing>fsec3</bpmn:outgoing></bpmn:sendTask>
    <bpmn:task id="Sec_CRM" name="Monitor + retry CRM tasks"><bpmn:incoming>fsec3</bpmn:incoming><bpmn:outgoing>fsec4</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="Sec_End" name="Done"><bpmn:incoming>fsec4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="fsec1" sourceRef="Sec_Start" targetRef="Sec_NoShow"/>
    <bpmn:sequenceFlow id="fsec2" sourceRef="Sec_NoShow" targetRef="Sec_SMS"/>
    <bpmn:sequenceFlow id="fsec3" sourceRef="Sec_SMS" targetRef="Sec_CRM"/>
    <bpmn:sequenceFlow id="fsec4" sourceRef="Sec_CRM" targetRef="Sec_End"/>
  </bpmn:process>

  <bpmn:process id="Proc_Doctor" name="Doctor" isExecutable="false">
    <bpmn:startEvent id="D_Start" name="Open dashboard"><bpmn:outgoing>fd1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="D_Agenda" name="View agenda + anomaly alerts"><bpmn:incoming>fd1</bpmn:incoming><bpmn:outgoing>fd2</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="D_Outcome" name="Mark appointment outcome"><bpmn:incoming>fd2</bpmn:incoming><bpmn:outgoing>fd3</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="D_DPA" name="Review + approve/reject DPA summary"><bpmn:incoming>fd3</bpmn:incoming><bpmn:outgoing>fd4</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="D_End" name="Done"><bpmn:incoming>fd4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="fd1" sourceRef="D_Start" targetRef="D_Agenda"/>
    <bpmn:sequenceFlow id="fd2" sourceRef="D_Agenda" targetRef="D_Outcome"/>
    <bpmn:sequenceFlow id="fd3" sourceRef="D_Outcome" targetRef="D_DPA"/>
    <bpmn:sequenceFlow id="fd4" sourceRef="D_DPA" targetRef="D_End"/>
  </bpmn:process>

  <bpmn:process id="Proc_Admin" name="Admin" isExecutable="false">
    <bpmn:startEvent id="A_Start" name="Open admin"><bpmn:outgoing>fa1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="A_Users" name="Provision users"><bpmn:incoming>fa1</bpmn:incoming><bpmn:outgoing>fa2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="A_Audit" name="GET /admin/audit-logs"><bpmn:incoming>fa2</bpmn:incoming><bpmn:outgoing>fa3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="A_Rerank" name="POST /admin/rerank-eval"><bpmn:incoming>fa3</bpmn:incoming><bpmn:outgoing>fa4</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="A_End" name="Done"><bpmn:incoming>fa4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="fa1" sourceRef="A_Start" targetRef="A_Users"/>
    <bpmn:sequenceFlow id="fa2" sourceRef="A_Users" targetRef="A_Audit"/>
    <bpmn:sequenceFlow id="fa3" sourceRef="A_Audit" targetRef="A_Rerank"/>
    <bpmn:sequenceFlow id="fa4" sourceRef="A_Rerank" targetRef="A_End"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_E2E">
      <bpmndi:BPMNShape id="Part_Patient_di" bpmnElement="Part_Patient" isHorizontal="true"><dc:Bounds x="50" y="20" width="1400" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_System_di" bpmnElement="Part_System" isHorizontal="true"><dc:Bounds x="50" y="200" width="2200" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_Secretary_di" bpmnElement="Part_Secretary" isHorizontal="true"><dc:Bounds x="50" y="420" width="1400" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_Doctor_di" bpmnElement="Part_Doctor" isHorizontal="true"><dc:Bounds x="50" y="580" width="1400" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_Admin_di" bpmnElement="Part_Admin" isHorizontal="true"><dc:Bounds x="50" y="740" width="1400" height="140"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="P_Start_di" bpmnElement="P_Start"><dc:Bounds x="100" y="85" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Login_di" bpmnElement="P_Login"><dc:Bounds x="180" y="63" width="140" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Action_di" bpmnElement="P_Action" isMarkerVisible="true"><dc:Bounds x="360" y="78" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Chat_di" bpmnElement="P_Chat"><dc:Bounds x="460" y="40" width="140" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Book_di" bpmnElement="P_Book"><dc:Bounds x="460" y="100" width="140" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Vitals_di" bpmnElement="P_Vitals"><dc:Bounds x="640" y="40" width="140" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_End_di" bpmnElement="P_End"><dc:Bounds x="820" y="85" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Start_di" bpmnElement="S_Start"><dc:Bounds x="100" y="285" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Auth_di" bpmnElement="S_Auth"><dc:Bounds x="180" y="263" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_RAG_di" bpmnElement="S_RAG"><dc:Bounds x="380" y="263" width="200" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Predict_di" bpmnElement="S_Predict"><dc:Bounds x="620" y="263" width="220" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_CRM_di" bpmnElement="S_CRM"><dc:Bounds x="880" y="263" width="240" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_IoT_di" bpmnElement="S_IoT"><dc:Bounds x="1160" y="263" width="280" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW_di" bpmnElement="S_GW" isMarkerVisible="true"><dc:Bounds x="1480" y="278" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Push_di" bpmnElement="S_Push"><dc:Bounds x="1580" y="263" width="220" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_di" bpmnElement="S_End"><dc:Bounds x="1840" y="285" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Sec_Start_di" bpmnElement="Sec_Start"><dc:Bounds x="100" y="475" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sec_NoShow_di" bpmnElement="Sec_NoShow"><dc:Bounds x="180" y="465" width="220" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sec_SMS_di" bpmnElement="Sec_SMS"><dc:Bounds x="440" y="465" width="220" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sec_CRM_di" bpmnElement="Sec_CRM"><dc:Bounds x="700" y="465" width="220" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sec_End_di" bpmnElement="Sec_End"><dc:Bounds x="960" y="475" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="D_Start_di" bpmnElement="D_Start"><dc:Bounds x="100" y="635" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Agenda_di" bpmnElement="D_Agenda"><dc:Bounds x="180" y="625" width="220" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Outcome_di" bpmnElement="D_Outcome"><dc:Bounds x="440" y="625" width="220" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_DPA_di" bpmnElement="D_DPA"><dc:Bounds x="700" y="625" width="260" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_End_di" bpmnElement="D_End"><dc:Bounds x="1000" y="635" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="A_Start_di" bpmnElement="A_Start"><dc:Bounds x="100" y="795" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Users_di" bpmnElement="A_Users"><dc:Bounds x="180" y="785" width="200" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Audit_di" bpmnElement="A_Audit"><dc:Bounds x="420" y="785" width="220" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Rerank_di" bpmnElement="A_Rerank"><dc:Bounds x="680" y="785" width="220" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_End_di" bpmnElement="A_End"><dc:Bounds x="940" y="795" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="fp1_di" bpmnElement="fp1"><di:waypoint x="136" y="103"/><di:waypoint x="180" y="103"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fp2_di" bpmnElement="fp2"><di:waypoint x="320" y="103"/><di:waypoint x="360" y="103"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fp_chat_di" bpmnElement="fp_chat"><di:waypoint x="410" y="103"/><di:waypoint x="460" y="65"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fp_book_di" bpmnElement="fp_book"><di:waypoint x="410" y="103"/><di:waypoint x="460" y="125"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fp_vitals_di" bpmnElement="fp_vitals"><di:waypoint x="600" y="65"/><di:waypoint x="640" y="65"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fp3_di" bpmnElement="fp3"><di:waypoint x="780" y="65"/><di:waypoint x="820" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fp4_di" bpmnElement="fp4"><di:waypoint x="600" y="125"/><di:waypoint x="820" y="105"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fp5_di" bpmnElement="fp5"><di:waypoint x="780" y="65"/><di:waypoint x="820" y="100"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="fs1_di" bpmnElement="fs1"><di:waypoint x="136" y="303"/><di:waypoint x="180" y="303"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fs2_di" bpmnElement="fs2"><di:waypoint x="340" y="303"/><di:waypoint x="380" y="303"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fs3_di" bpmnElement="fs3"><di:waypoint x="580" y="303"/><di:waypoint x="620" y="303"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fs4_di" bpmnElement="fs4"><di:waypoint x="840" y="303"/><di:waypoint x="880" y="303"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fs5_di" bpmnElement="fs5"><di:waypoint x="1120" y="303"/><di:waypoint x="1160" y="303"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fs6_di" bpmnElement="fs6"><di:waypoint x="1440" y="303"/><di:waypoint x="1480" y="303"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fs_y_di" bpmnElement="fs_y"><di:waypoint x="1530" y="303"/><di:waypoint x="1580" y="303"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fs_n_di" bpmnElement="fs_n"><di:waypoint x="1505" y="328"/><di:waypoint x="1505" y="380"/><di:waypoint x="1858" y="380"/><di:waypoint x="1858" y="321"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fs7_di" bpmnElement="fs7"><di:waypoint x="1800" y="303"/><di:waypoint x="1840" y="303"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="fsec1_di" bpmnElement="fsec1"><di:waypoint x="136" y="493"/><di:waypoint x="180" y="493"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fsec2_di" bpmnElement="fsec2"><di:waypoint x="400" y="493"/><di:waypoint x="440" y="493"/></bpmndi:BPMNEdge>
